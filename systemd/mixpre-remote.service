[Unit]
Description=MixPre Remote bridge (Bluetooth + Wi-Fi web control)
After=bluetooth.service mixpre-gadget.service
Wants=bluetooth.service
# keep restarting (an update guard decides when to roll back)
StartLimitIntervalSec=0

[Service]
ExecStartPre=-/usr/sbin/rfkill unblock all
ExecStartPre=-/usr/bin/bluetoothctl power on
ExecStartPre=-/usr/bin/python3 /opt/mixpre-remote/guard.py
ExecStart=/opt/mixpre-remote/venv/bin/python /opt/mixpre-remote/current/mixpre_remote.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
