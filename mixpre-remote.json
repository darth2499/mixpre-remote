    },
    {
      "name": "Scene write request",
      "match": "F0 42 4? 00 01 13 00 1F 11 *",
      "reply": "F0 42 40 00 01 13 00 5F 21 00 F7"
    },
    {
      "name": "Scene dump request",
      "match": "F0 42 4? 00 01 13 00 1F 10 *",
